# Local runtime config for the BTC 10-Strategy dashboard.
# Copy to .env and edit — .env is gitignored, so each checkout/branch keeps its
# own port and no port change is ever committed.
#
#   cp .env.example .env
#
# An inline override still wins over this file:  PORT=9000 ./run.sh

# Port the dashboard listens on. Give every parallel checkout a distinct value.
PORT=8100

# Bind address. 0.0.0.0 exposes it on the network; 127.0.0.1 is local-only.
HOST=0.0.0.0

# --- Chainlink Data Streams (optional; settlement source for 5m/15m markets) ---
# Get these from your Chainlink Data Streams onboarding. Leave blank to disable.
CHAINLINK_API_KEY=
CHAINLINK_USER_SECRET=
# BTC/USD stream feed ID — verify against data.chain.link / your onboarding.
CHAINLINK_BTC_FEED_ID=0x00039d9e45394f473ab1f050a1b963e6b05351e52d71e507509ada0c95ed75b8
