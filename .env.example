# Local runtime config for the BTC 10-Strategy dashboard.
# Copy to .env and edit — .env is gitignored, so each checkout/branch keeps its
# own port and no port change is ever committed.
#
#   cp .env.example .env
#
# An inline override still wins over this file:  PORT=9000 ./run.sh

# Port the dashboard listens on. Give every parallel checkout a distinct value.
PORT=8100

# Bind address. 0.0.0.0 exposes it on the network; 127.0.0.1 is local-only.
HOST=0.0.0.0

# SQLite store path. Defaults to data/market.db in this checkout if unset, but
# every checkout on this machine shares one copy at the path below instead of
# each building/duplicating its own multi-hundred-MB database.
MARKET_DB=/work/david/PolyMarket/database/market.db

# --- PMData (optional; full-history Polymarket order book) ---------------------
# API key from pmdata.dev. Powers `python3 -m backend.data.ingest_pmdata`, which
# backfills Polymarket price + L2 depth from 2026-02-13 onward.
# NOTE ON BILLING: PMData charges by *day unlocked*, and an unlocked day is then
# free forever across every series and data type. The ingester therefore keeps
# each downloaded archive on disk and never re-fetches it — the SQLite tables can
# always be rebuilt from the archive without spending quota again.
PMDATA_API_KEY=
# Where the daily .zip archives live (~200 MB/day, ~34 GB for the full history).
# Defaults to a `pmdata` directory beside MARKET_DB, shared between checkouts.
PMDATA_ARCHIVE=

# --- Chainlink Data Streams (optional; settlement source for 5m/15m markets) ---
# Get these from your Chainlink Data Streams onboarding. Leave blank to disable.
CHAINLINK_API_KEY=
CHAINLINK_USER_SECRET=
# BTC/USD stream feed ID — verify against data.chain.link / your onboarding.
CHAINLINK_BTC_FEED_ID=0x00039d9e45394f473ab1f050a1b963e6b05351e52d71e507509ada0c95ed75b8
